        "    (\"A:277-LEU\",\"B:532-ARG\"), (\"A:292-LEU\",\"B:530-TRP\"), (\"A:282-GLY\",\"B:471-TRP\"),\n",
        "    (\"A:287-SER\",\"B:471-TRP\"), (\"A:287-SER\",\"B:445-TRP\"), (\"A:283-SER\",\"B:472-PRO\"),\n",
        "    (\"A:282-GLY\",\"B:473-ASN\"), (\"A:297-GLU\",\"B:511-LYS\"), (\"A:299-PRO\",\"B:511-LYS\"),\n",
        "    (\"A:280-ASN\",\"B:489-ALA\"), (\"A:291-LEU\",\"B:490-LYS\"), (\"A:297-GLU\",\"B:532-ARG\"),\n",
        "    (\"A:298-ASP\",\"B:511-LYS\"), (\"A:293-ARG\",\"B:492-ASP\"), (\"A:281-ARG\",\"B:491-THR\"),\n",
        "    (\"A:278-TYR\",\"B:533-ARG\"), (\"A:285-ARG\",\"B:362-ARG\"), (\"A:293-ARG\",\"B:531-GLN\"),\n",
        "    (\"A:277-LEU\",\"B:511-LYS\"), (\"A:284-ASN\",\"B:386-ASP\"), (\"A:277-LEU\",\"B:533-ARG\"),\n",
        "    (\"A:281-ARG\",\"B:531-GLN\"), (\"A:288-ARG\",\"B:429-ARG\"), (\"A:299-PRO\",\"B:510-ASP\"),\n",
        "    (\"A:285-ARG\",\"B:316-ARG\"), (\"A:280-ASN\",\"B:531-GLN\"), (\"A:282-GLY\",\"B:516-PHE\"),\n",
        "    (\"A:288-ARG\",\"B:556-MET\"), (\"A:288-ARG\",\"B:343-ILE\"), (\"A:282-GLY\",\"B:515-ILE\"),\n",
        "    (\"A:288-ARG\",\"B:530-TRP\"), (\"A:281-ARG\",\"B:488-ASP\"), (\"A:283-SER\",\"B:386-ASP\"),\n",
        "    (\"A:281-ARG\",\"B:513-PRO\"), (\"A:284-ASN\",\"B:471-TRP\"), (\"A:288-ARG\",\"B:517-GLY\")\n",
        "}\n",
        "\n",
        "# =====================\n",
        "# Load Excel data\n",
        "# =====================\n",
        "file_path = '/content/drive/My Drive/MD/yld/wnt5_1_NClinker.xlsx'\n",
        "df = pd.read_excel(file_path, header=None, names=[\"Residue_A\", \"Residue_B\"])\n",
        "\n",
        "# Extract residues\n",
        "df[\"Chain_A\"] = df[\"Residue_A\"].str.split(\":\").str[0]\n",
        "df[\"ResNum_A\"] = df[\"Residue_A\"].str.split(\":\").str[1]\n",
        "df[\"Chain_B\"] = df[\"Residue_B\"].str.split(\":\").str[0]\n",
        "df[\"ResNum_B\"] = df[\"Residue_B\"].str.split(\":\").str[1]\n",
        "\n",
        "# Positioning\n",
        "residues_A = df[\"Residue_A\"].unique()\n",
        "residues_B = df[\"Residue_B\"].unique()\n",
        "y_A = {res: i for i, res in enumerate(residues_A)}\n",
        "y_B = {res: i for i, res in enumerate(residues_B)}\n",
        "\n",
        "# =====================\n",
        "# Map pairs → types\n",
        "# =====================\n",
        "pair_types = defaultdict(list)\n",
        "for pair in df.itertuples(index=False):\n",
        "    p = (pair.Residue_A, pair.Residue_B)\n",
        "    if p in hbonds: pair_types[p].append(\"hbond\")\n",
        "    if p in salt_bridges: pair_types[p].append(\"salt\")\n",
        "    if p in pi_cation: pair_types[p].append(\"pi\")\n",
        "    if p in hydrophobic: pair_types[p].append(\"hydro\")\n",
        "    if p in vanderwaals: pair_types[p].append(\"vdw\")\n",
        "    if not pair_types[p]:  # no match\n",
        "        pair_types[p].append(\"other\")\n",
        "\n",
        "# =====================\n",
        "# Plot Setup\n",
        "# =====================\n",
        "plt.figure(figsize=(9, 12))\n",
        "ax = plt.gca()\n",
        "\n",
        "# Residue nodes\n",
        "for res, y in y_A.items():\n",
        "    ax.plot(0, y, 'o', color='steelblue', markersize=8)\n",
        "    ax.text(-0.2, y, res, ha='right', va='center', fontsize=9, fontweight='bold')\n",
        "\n",
        "for res, y in y_B.items():\n",
        "    ax.plot(1, y, 'o', color='darkorange', markersize=8)\n",
        "    ax.text(1.2, y, res, ha='left', va='center', fontsize=9, fontweight='bold')\n",
        "\n",
        "# Colors\n",
        "color_map = {\n",
        "    \"hbond\": \"blue\",\n",
        "    \"salt\": \"gold\",\n",
        "    \"pi\": \"deeppink\",\n",
        "    \"hydro\": \"green\",\n",
        "    \"vdw\": \"grey\",   # changed to grey\n",
        "    \"other\": \"lightgray\"\n",
        "}\n",
        "\n",
        "type_counts = defaultdict(int)\n",
        "# Draw multiple lines per pair, slightly offset, with more visible widths\n",
        "offset = 0.04\n",
        "base_lw = 2.5  # base line width increased\n",
        "for pair, types in pair_types.items():\n",
        "    y1, y2 = y_A[pair[0]], y_B[pair[1]]\n",
        "    n = len(types)\n",
        "    start = - (n-1)/2 * offset\n",
        "    for i, t in enumerate(types):\n",
        "        lw = base_lw + 0.7*(n-1)  # increase width more for multiple interactions\n",
        "        con = mpatches.ConnectionPatch(\n",
        "            (0, y1 + start + i*offset),\n",
        "            (1, y2 + start + i*offset),\n",
        "            \"data\", \"data\",\n",
        "            arrowstyle=\"-\", lw=lw, color=color_map[t], alpha=0.9\n",
        "        )\n",
        "        ax.add_patch(con)\n",
        "        type_counts[t] += 1\n",
        "\n",
        "# =====================\n",
        "# Legend + Style\n",
        "# =====================\n",
        "patches = [\n",
        "    mpatches.Patch(color=color_map[\"hbond\"], label=f\"Hbond ({type_counts['hbond']})\"),\n",
        "    mpatches.Patch(color=color_map[\"salt\"], label=f\"Salt bridge ({type_counts['salt']})\"),\n",
        "    mpatches.Patch(color=color_map[\"pi\"], label=f\"Pi–cation ({type_counts['pi']})\"),\n",
        "    mpatches.Patch(color=color_map[\"hydro\"], label=f\"Hydrophobic ({type_counts['hydro']})\"),\n",
        "    mpatches.Patch(color=color_map[\"vdw\"], label=f\"Van der Waals ({type_counts['vdw']})\"),\n",
        "    mpatches.Patch(color=color_map[\"other\"], label=f\"Other ({type_counts['other']})\")\n",
        "]\n",
        "ax.legend(handles=patches, loc=\"upper center\", bbox_to_anchor=(0.5, -0.05),\n",
        "          ncol=3, fontsize=9, frameon=False)\n",
        "\n",
        "ax.set_xlim(-0.5, 1.5)\n",
        "ax.set_ylim(-1, max(len(residues_A), len(residues_B)))\n",
        "ax.axis('off')\n",
        "plt.title(\"Inter-chain Residue Interactions\", fontsize=14, fontweight='bold')\n",
        "plt.tight_layout()\n",
        "plt.show()"
