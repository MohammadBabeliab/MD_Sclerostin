        "        if contact_fraction > 0.65:\n",
        "            A_res = int(residues_part.split('--')[0].split(':')[1].strip())  # Chain A\n",
        "            B_res = int(residues_part.split('--')[1].split(':')[1].strip()) - 610  # Chain B renumbered\n",
        "            contacts.append((A_res, B_res))\n",
        "\n",
        "# Separate residues\n",
        "A_residues = [c[0] for c in contacts]\n",
        "B_residues = [c[1] for c in contacts]\n",
        "\n",
        "# Create figure and axes\n",
        "fig, ax_left = plt.subplots(figsize=(8, 6))\n",
        "ax_right = ax_left.twinx()\n",
        "\n",
        "# Set limits first (so transformation works correctly)\n",
        "ax_left.set_ylim(0, 620)   # Chain A up to 600\n",
