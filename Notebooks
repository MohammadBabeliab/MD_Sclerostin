        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# ---------- Function to read .xvg ----------\n",
        "def read_xvg(file_path):\n",
        "    x, y = [], []\n",
        "    with open(file_path, 'r') as f:\n",
        "        for line in f:\n",
        "            if line.startswith(('#', '@')):\n",
        "                continue\n",
        "            parts = line.strip().split()\n",
        "            if len(parts) >= 2:\n",
        "                x.append(float(parts[0]))\n",
        "                y.append(float(parts[1]))\n",
        "    return np.array(x), np.array(y)\n",
        "\n",
        "# ---------- File paths ----------\n",
        "paths_dict = {\n",
        "    \"SOST-LRP6 (CoG)\": [\n",
        "        '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/1/dist_SOST_LRP6.xvg',\n",
        "        '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/2/dist_SOST_LRP6.xvg',\n",
        "        '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/3/dist_SOST_LRP6.xvg'\n",
        "    ]}\n",
        "# ---------- Helper: average replicates ----------\n",
        "def average_replicates(datasets, n_points=800):\n",
        "    max_time = min(max(x) for x, _ in datasets)\n",
        "    common_time = np.linspace(0, max_time, n_points)\n",
        "    interp_data = [np.interp(common_time, x, y) for (x, y) in datasets]\n",
        "    array = np.array(interp_data)\n",
        "    return common_time, array.mean(axis=0), array.std(axis=0)\n",
        "\n",
        "# ---------- Read and process ----------\n",
        "colors = [\"blue\", \"red\", \"green\", \"orange\"]\n",
        "\n",
        "plt.figure(figsize=(12,6))\n",
        "\n",
        "for (label, file_list), color in zip(paths_dict.items(), colors):\n",
        "    rep_data = [read_xvg(p) for p in file_list]\n",
        "    t, mean_vals, std_vals = average_replicates(rep_data)\n",
        "\n",
        "    plt.plot(t, mean_vals, color=color, label=label)\n",
        "    plt.fill_between(t, mean_vals-std_vals, mean_vals+std_vals, color=color, alpha=0.1)\n",
        "\n",
        "# ---------- Plot formatting ----------\n",
        "plt.xlabel('Time (ns)')\n",
        "plt.ylabel('Distance (nm)')\n",
        "plt.title('Center of Geometry Distances: Mean ± Std across Replicates')\n",
        "plt.legend()\n",
        "plt.grid(False)\n",
        "plt.xlim(0, 500)   # crop at 500 ns\n",
        "#plt.ylim(0, None)  # start y from 0\n",
        "plt.xticks(np.arange(0,501,25))\n",
