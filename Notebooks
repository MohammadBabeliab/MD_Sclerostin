        "import pandas as pd\n",
        "import os\n",
        "from google.colab import drive\n",
        "\n",
        "# --- Mount Google Drive ---\n",
        "drive.mount('/content/drive', force_remount=True)\n",
        "\n",
        "# --- File paths ---\n",
        "input_file = '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/contacts_overall.xlsx'\n",
        "output_file = '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/conserved_contacts.xlsx'\n",
        "\n",
        "# --- Detect file type ---\n",
        "ext = os.path.splitext(input_file)[1].lower()\n",
        "\n",
        "if ext == \".csv\":\n",
        "    df = pd.read_csv(\n",
        "        input_file,\n",
        "        encoding='latin1',\n",
        "        header=1,           # skip first row (\"1st REP / 2nd REP / 3rd REP\")\n",
        "        engine='python',\n",
        "        quotechar='\"',\n",
        "        on_bad_lines='skip'\n",
        "    )\n",
        "elif ext in [\".xls\", \".xlsx\"]:\n",
        "    df = pd.read_excel(input_file, header=1)\n",
        "elif ext == \".ods\":\n",
        "    # Ensure odfpy is installed\n",
        "    try:\n",
        "        df = pd.read_excel(input_file, header=1, engine=\"odf\")\n",
        "    except ImportError:\n",
        "        print(\"⚠️ Installing odfpy for ODS support...\")\n",
        "        !pip install odfpy\n",
        "        df = pd.read_excel(input_file, header=1, engine=\"odf\")\n",
        "else:\n",
        "    raise ValueError(f\"Unsupported file extension: {ext}\")\n",
        "\n",
        "# --- Clean column names ---\n",
        "df.columns = df.columns.str.strip()\n",
        "print(\"✅ Columns in file:\", df.columns.tolist())\n",
        "\n",
        "# --- Collect replicates dynamically ---\n",
        "reps = []\n",
        "for i in range(3):  # loop over 3 replicates\n",
        "    suffix = '' if i == 0 else f'.{i}'\n",
        "    cols = [f'Residue_A{suffix}', f'Residue_B{suffix}', f'Contact_%{suffix}']\n",
        "    missing = [c for c in cols if c not in df.columns]\n",
        "    if missing:\n",
        "        raise ValueError(f\"Missing columns for replicate {i+1}: {missing}\")\n",
        "    rep = df[cols].copy()\n",
        "    rep.columns = ['Residue_A', 'Residue_B', 'Contact_%']\n",
        "    rep['rep'] = i + 1\n",
        "    reps.append(rep)\n",
        "\n",
        "# --- Combine all replicates ---\n",
        "all_reps = pd.concat(reps, ignore_index=True)\n",
        "\n",
        "# --- Ensure numeric Contact_% ---\n",
        "all_reps['Contact_%'] = pd.to_numeric(all_reps['Contact_%'], errors='coerce')\n",
        "\n",
        "# --- Drop rows with missing data ---\n",
        "all_reps.dropna(subset=['Residue_A', 'Residue_B', 'Contact_%'], inplace=True)\n",
        "\n",
        "# --- Find conserved contacts ---\n",
        "conserved = (\n",
        "    all_reps.groupby(['Residue_A', 'Residue_B'])\n",
        "    .agg(\n",
        "        reps_present=('rep', 'nunique'),\n",
        "        avg_contact=('Contact_%', 'mean')\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# --- Keep only contacts present in all 3 replicates ---\n",
        "conserved = conserved[conserved['reps_present'] == 3]\n",
        "\n",
        "# --- Save results ---\n",
        "conserved[['Residue_A', 'Residue_B', 'avg_contact']].to_csv(output_file, index=False)\n",
        "\n",
        "print(f\"✅ Conserved contacts saved to: {output_file}\")\n",
        "pd.set_option(\"display.max_rows\", None)   # Show all rows\n",
        "pd.set_option(\"display.max_columns\", None)  # Show all columns\n",
        "\n",
        "print(conserved)\n"
      ],
