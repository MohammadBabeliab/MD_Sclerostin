      "source": [
        "AlphaCarbon of SOST protein in free and complex states"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# ---------- Function to read .xvg ----------\n",
        "def read_xvg(file_path):\n",
        "    x, y = [], []\n",
        "    with open(file_path, 'r') as f:\n",
        "        for line in f:\n",
        "            if line.startswith(('#', '@')):\n",
        "                continue\n",
        "            parts = line.strip().split()\n",
        "            if len(parts) >= 2:\n",
        "                x.append(float(parts[0]))\n",
        "                y.append(float(parts[1]))\n",
        "    return np.array(x), np.array(y)\n",
        "\n",
        "# ---------- Function for convergence stats ----------\n",
        "def convergence_metric(x, y, final_ns=350):\n",
        "    max_time = max(x)\n",
        "    threshold_time = max_time - final_ns\n",
        "    recent_rmsds = [y[i] for i in range(len(x)) if x[i] >= threshold_time]\n",
        "    return np.mean(recent_rmsds), np.std(recent_rmsds)\n",
        "\n",
        "# ---------- File paths ----------\n",
        "SOST_free_path = '/content/drive/My Drive/MD/MY_ANALYSIS/SOST/1/rmsd_CarbonAlpha_SOST.xvg'\n",
        "replica_paths = [\n",
        "    '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/1/rmsd_CarbonAlpha_SOST.xvg',\n",
        "    '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/2/rmsd_CarbonAlpha_SOST.xvg',\n",
        "    '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/3/rmsd_CarbonAlpha_SOST.xvg'\n",
        "]\n",
        "\n",
        "# ---------- Read data ----------\n",
        "x_free, y_free = read_xvg(SOST_free_path)\n",
        "replica_data = [read_xvg(p) for p in replica_paths]\n",
        "\n",
        "\n",
        "# ---------- 2. Mean ± std shaded plot ----------\n",
        "# Interpolate to a common time grid\n",
        "max_time = min(max(x) for x, _ in replica_data)  # shortest sim length\n",
        "common_time = np.linspace(0, max_time, 1000)\n",
        "replica_interp = [np.interp(common_time, x, y) for (x, y) in replica_data]\n",
        "\n",
        "replica_array = np.array(replica_interp)\n",
        "mean_rmsd = replica_array.mean(axis=0)\n",
        "std_rmsd = replica_array.std(axis=0)\n",
        "\n",
        "plt.figure(figsize=(10,6))\n",
        "plt.plot(common_time, mean_rmsd, color='red', label='Complex (mean of 3 reps)')\n",
        "plt.fill_between(common_time, mean_rmsd-std_rmsd, mean_rmsd+std_rmsd,\n",
        "                 color='red', alpha=0.1, label='± Std Dev')\n",
        "plt.plot(x_free, y_free, color='blue', linewidth=1.2, label='SOST Free')\n",
        "\n",
        "plt.xlabel('Time (ns)')\n",
        "plt.ylabel('RMSD (nm)')\n",
        "plt.title('Cα RMSD of SOST: Mean ± Std across Replicates')\n",
        "plt.legend()\n",
        "plt.grid(False)\n",
        "plt.xlim(0, 500)   # crop at 500 ns\n",
        "plt.ylim(0, None)  # start y from 0\n",
        "plt.xticks(np.arange(0,501,25))\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------- 3. Convergence stats ----------\n",
        "print(\"\\nConvergence (last 350 ns):\")\n",
        "mean_free, std_free = convergence_metric(x_free, y_free)\n",
        "print(f'  SOST Free: Mean = {mean_free:.3f} nm, Std = {std_free:.3f} nm')\n",
        "\n",
        "for i, (x, y) in enumerate(replica_data, 1):\n",
        "    mean, std = convergence_metric(x, y)\n",
        "    print(f'  Complex Rep {i}: Mean = {mean:.3f} nm, Std = {std:.3f} nm')\n",
        "\n",
        "# Mean across reps (last 350ns)\n",
        "rep_means, rep_stds = [], []\n",
        "for x, y in replica_data:\n",
        "    m, s = convergence_metric(x, y)\n",
        "    rep_means.append(m)\n",
        "    rep_stds.append(s)\n",
        "print(f'  Complex (avg of 3 reps): Mean = {np.mean(rep_means):.3f} nm, Std = {np.mean(rep_stds):.3f} nm')\n"
      ],
