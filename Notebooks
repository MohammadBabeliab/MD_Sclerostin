      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# File paths\n",
        "rmsd_rg_SOST_complex = '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/3/average_rmsd_rg_SOST.xvg'\n",
        "rmsd_rg_SOST_free = '/content/drive/My Drive/MD/MY_ANALYSIS/SOST/rmsd_rg_SOST.xvg'\n",
        "\n",
        "# Load data\n",
        "data_c = np.loadtxt(rmsd_rg_SOST_complex)\n",
        "xc, yc = data_c[:, 1], data_c[:, 2]   # RMSD, Rg for complex\n",
        "\n",
        "data_f = np.loadtxt(rmsd_rg_SOST_free)\n",
        "xf, yf = data_f[:, 1], data_f[:, 2]   # RMSD, Rg for free\n",
        "\n",
        "# Create 2D histograms\n",
        "nbins = 50\n",
        "Hc, xedges, yedges = np.histogram2d(xc, yc, bins=nbins, density=True)\n",
        "Hf, _, _ = np.histogram2d(xf, yf, bins=[xedges, yedges], density=True)\n",
        "# use same bin edges for fair comparison\n",
        "\n",
        "# Convert probability to free energy (ΔG = -kT ln P)\n",
        "kT = 2.4943  # kJ/mol at 300K\n",
        "Hc = np.where(Hc == 0, np.nan, Hc)\n",
        "Fc = -kT * np.log(Hc)\n",
        "Fc = Fc - np.nanmin(Fc)\n",
        "\n",
        "Hf = np.where(Hf == 0, np.nan, Hf)\n",
        "Ff = -kT * np.log(Hf)\n",
        "Ff = Ff - np.nanmin(Ff)\n",
        "\n",
        "# Plot FEL for complex\n",
        "plt.figure(figsize=(8, 6))\n",
        "extent = [xedges[0], xedges[-1], yedges[0], yedges[-1]]\n",
        "plt.imshow(Fc.T, origin='lower', extent=extent, aspect='auto', cmap='viridis')\n",
        "plt.xlabel('RMSD (nm)')\n",
        "plt.ylabel('Radius of Gyration (nm)')\n",
        "plt.title('SOST Complex State FEL (kJ/mol)')\n",
        "cbar = plt.colorbar()\n",
        "cbar.set_label('ΔG (kJ/mol)')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Plot FEL for free state\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.imshow(Ff.T, origin='lower', extent=extent, aspect='auto', cmap='viridis')\n",
        "plt.xlabel('RMSD (nm)')\n",
        "plt.ylabel('Radius of Gyration (nm)')\n",
        "plt.title('SOST Apo State FEL (kJ/mol)')\n",
