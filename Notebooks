      "source": [
        "from scipy.ndimage import zoom\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import re\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "from mpl_toolkits.mplot3d import Axes3D\n",
        "\n",
        "# --- XPM Reader ---\n",
        "def read_xpm(filename):\n",
        "    with open(filename, 'r') as f:\n",
        "        lines = f.readlines()\n",
        "\n",
        "    width = height = num_colors = chars_per_pixel = None\n",
        "    colormap = {}\n",
        "    data_lines = []\n",
        "\n",
        "    state = 'header'\n",
        "    for line in lines:\n",
        "        line = line.strip()\n",
        "        if not line.startswith('\"'):\n",
        "            continue\n",
        "\n",
        "        content = line.strip('\",')\n",
        "\n",
        "        if state == 'header':\n",
        "            parts = content.split()\n",
        "            if len(parts) >= 4:\n",
        "                width, height, num_colors, chars_per_pixel = map(int, parts[:4])\n",
        "                state = 'colormap'\n",
        "            continue\n",
        "\n",
        "        elif state == 'colormap':\n",
        "            if len(colormap) < num_colors:\n",
        "                match = re.match(r'(\\S+)\\s+c\\s.*\"([\\d\\.]+)\"', content)\n",
        "                if not match:\n",
        "                    match = re.match(r'(\\S+)\\s+c\\s.*\\s([\\d\\.]+)$', content)\n",
        "                if match:\n",
        "                    symbol = match.group(1)\n",
        "                    value = float(match.group(2))\n",
        "                    colormap[symbol] = value\n",
        "                continue\n",
        "            else:\n",
        "                state = 'matrix'\n",
        "\n",
        "        if state == 'matrix':\n",
        "            if len(content) == width * chars_per_pixel:\n",
        "                row = [colormap[content[i:i+chars_per_pixel]] for i in range(0, len(content), chars_per_pixel)]\n",
        "                data_lines.append(row)\n",
        "\n",
        "    data_array = np.array(data_lines)\n",
        "    data_array = np.flipud(data_array)\n",
        "    return data_array\n",
        "\n",
        "# --- Load FEL Data ---\n",
        "FEL_FILE_COMPLEX = '/content/drive/My Drive/MD/ANALYSISwithHPC_complex/3/fel_sost.xpm'\n",
        "FEL_FILE_APO = '/content/drive/My Drive/MD/MY_ANALYSIS/SOST/fel_sost.xpm'\n",
        "\n",
        "fel_data_complex = read_xpm(FEL_FILE_COMPLEX)\n",
        "fel_data_apo = read_xpm(FEL_FILE_APO)\n",
        "\n",
        "# --- Moderate Resolution Increase ---\n",
        "zoom_factor = 2\n",
        "fel_data_complex_balanced = zoom(fel_data_complex, zoom_factor, order=3)\n",
        "fel_data_apo_balanced = zoom(fel_data_apo, zoom_factor, order=3)\n",
        "\n",
        "# --- Axis Ranges ---\n",
        "# Complex\n",
        "rmsd_min_c, rmsd_max_c = 0.001, 2.891\n",
        "rg_min_c, rg_max_c     = 2.595, 4.242\n",
        "x_c = np.linspace(rmsd_min_c, rmsd_max_c, fel_data_complex_balanced.shape[1])\n",
        "y_c = np.linspace(rg_min_c, rg_max_c, fel_data_complex_balanced.shape[0])\n",
        "\n",
        "# Apo\n",
        "rmsd_min_a, rmsd_max_a = 0.000, 3.711\n",
        "rg_min_a, rg_max_a     = 2.279, 4.194\n",
        "x_a = np.linspace(rmsd_min_a, rmsd_max_a, fel_data_apo_balanced.shape[1])\n",
        "y_a = np.linspace(rg_min_a, rg_max_a, fel_data_apo_balanced.shape[0])\n",
        "\n",
        "# --- Fixed color limits ---\n",
        "vmin = 0\n",
        "vmax = 17\n",
        "contour_levels = np.linspace(vmin, vmax, 6)\n",
        "\n",
        "# ================= 2D SIDE-BY-SIDE PLOTS =================\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 6))\n",
        "\n",
        "# Complex\n",
        "extent_c = [x_c.min(), x_c.max(), y_c.min(), y_c.max()]\n",
        "im1 = axes[0].imshow(fel_data_complex_balanced, extent=extent_c, origin='lower', aspect='auto',\n",
        "                     cmap='jet', vmin=vmin, vmax=vmax)\n",
        "axes[0].contour(fel_data_complex_balanced, levels=contour_levels, colors='black',\n",
        "                linewidths=0.5, origin='lower', extent=extent_c)\n",
        "axes[0].set_title('Complex State')\n",
        "axes[0].set_xlabel('RMSD (nm)')\n",
        "axes[0].set_ylabel('Rg (nm)')\n",
        "\n",
        "# Apo\n",
        "extent_a = [x_a.min(), x_a.max(), y_a.min(), y_a.max()]\n",
        "im2 = axes[1].imshow(fel_data_apo_balanced, extent=extent_a, origin='lower', aspect='auto',\n",
        "                     cmap='jet', vmin=vmin, vmax=vmax)\n",
        "axes[1].contour(fel_data_apo_balanced, levels=contour_levels, colors='black',\n",
        "                linewidths=0.5, origin='lower', extent=extent_a)\n",
        "axes[1].set_title('Apo State')\n",
        "axes[1].set_xlabel('RMSD (nm)')\n",
        "\n",
        "# Colorbar\n",
        "cbar_ax = fig.add_axes([0.92, 0.15, 0.02, 0.7])\n",
        "cbar = fig.colorbar(im1, cax=cbar_ax)\n",
        "cbar.set_label('G (kJ/mol)', fontsize=12)\n",
        "\n",
        "plt.tight_layout(rect=[0, 0, 0.9, 1])\n",
        "plt.show()\n",
        "\n",
        "# ================= 3D SIDE-BY-SIDE PLOTS (MATPLOTLIB) =================\n",
        "fig = plt.figure(figsize=(16, 6))\n",
        "\n",
        "# Complex\n",
        "ax1 = fig.add_subplot(1, 2, 1, projection='3d')\n",
        "X_c, Y_c = np.meshgrid(x_c, y_c)\n",
        "Z_complex = fel_data_complex_balanced\n",
        "surf1 = ax1.plot_surface(X_c, Y_c, Z_complex, cmap='jet', edgecolor='none', vmin=vmin, vmax=vmax)\n",
        "ax1.set_title('Complex State')\n",
        "ax1.set_xlabel('RMSD (nm)')\n",
        "ax1.set_ylabel('Rg (nm)')\n",
        "ax1.set_zlabel('G (kJ/mol)')\n",
        "fig.colorbar(surf1, ax=ax1, shrink=0.5, aspect=10)\n",
        "\n",
        "# Apo\n",
        "ax2 = fig.add_subplot(1, 2, 2, projection='3d')\n",
        "X_a, Y_a = np.meshgrid(x_a, y_a)\n",
        "Z_apo = fel_data_apo_balanced\n",
        "surf2 = ax2.plot_surface(X_a, Y_a, Z_apo, cmap='jet', edgecolor='none', vmin=vmin, vmax=vmax)\n",
        "ax2.set_title('Apo State')\n",
        "ax2.set_xlabel('RMSD (nm)')\n",
        "ax2.set_ylabel('Rg (nm)')\n",
        "ax2.set_zlabel('G (kJ/mol)')\n",
        "fig.colorbar(surf2, ax=ax2, shrink=0.5, aspect=10)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ================= 3D SIDE-BY-SIDE PLOTS (PLOTLY) =================\n",
        "fig_plotly = make_subplots(\n",
        "    rows=1, cols=2,\n",
        "    specs=[[{'type':'surface'}, {'type':'surface'}]],\n",
        "    subplot_titles=['Complex State', 'Apo State']\n",
        ")\n",
        "\n",
        "# Complex\n",
        "fig_plotly.add_trace(go.Surface(\n",
        "    z=Z_complex, x=X_c, y=Y_c,\n",
        "    colorscale='Jet', cmin=vmin, cmax=vmax, colorbar=dict(title='G (kJ/mol)')\n",
        "), row=1, col=1)\n",
        "\n",
        "# Apo\n",
        "fig_plotly.add_trace(go.Surface(\n",
        "    z=Z_apo, x=X_a, y=Y_a,\n",
        "    colorscale='Jet', cmin=vmin, cmax=vmax, showscale=False\n",
        "), row=1, col=2)\n",
        "\n",
        "fig_plotly.update_layout(\n",
        "    title='3D Free Energy Landscapes',\n",
        "    autosize=True,\n",
        "    margin=dict(l=65, r=50, b=65, t=90)\n",
        ")\n",
        "\n",
        "fig_plotly.show()\n"
      ],
